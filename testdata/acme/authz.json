  "Policies": [
    {
      "Arn": "arn:aws:iam::111122223333:policy/CiDeployerAccess",
      "AttachmentCount": 1,
      "DefaultVersionId": "v1",
      "IsAttachable": true,
      "PolicyName": "CiDeployerAccess",
      "PolicyVersionList": [
        {
          "Document": {
            "Statement": [
              {
                "Action": [
                  "*"
                ],
                "Condition": {
                  "StringEquals": {
                    "aws:RequestedRegion": [
                      "us-east-1",
                      "us-west-2"
                    ]
                  }
                },
                "Effect": "Allow",
                "Resource": [
                  "*"
                ],
                "Sid": "AdminInDeployRegions"
              },
              {
                "Action": [
                  "iam:PassRole"
                ],
                "Effect": "Allow",
                "Resource": [
                  "arn:aws:iam::111122223333:role/lambda-exec-*"
                ],
                "Sid": "PassExecRoles"
              }
            ],
            "Version": "2012-10-17"
          },
          "IsDefaultVersion": true,
          "VersionId": "v1"
        }
      ]
    },
    {
      "Arn": "arn:aws:iam::111122223333:policy/ReadOnlyAnalyst",
      "AttachmentCount": 1,
      "DefaultVersionId": "v1",
      "IsAttachable": true,
      "PolicyName": "ReadOnlyAnalyst",
      "PolicyVersionList": [
        {
          "Document": {
            "Statement": [
              {
                "Action": [
                  "s3:Get*",
                  "s3:List*"
                ],
                "Condition": {
                  "Bool": {
                    "aws:MultiFactorAuthPresent": "true"
                  }
                },
                "Effect": "Allow",
                "Resource": [
                  "*"
                ],
                "Sid": "ReadReports"
              },
              {
                "Action": [
                  "dynamodb:Describe*",
                  "dynamodb:Scan",
                  "dynamodb:Query",
                  "dynamodb:GetItem"
                ],
                "Effect": "Allow",
                "Resource": [
                  "arn:aws:dynamodb:*:111122223333:table/*"
                ],
                "Sid": "ReadMetrics"
              }
            ],
            "Version": "2012-10-17"
          },
          "IsDefaultVersion": true,
          "VersionId": "v1"
        }
      ]
    },
    {
      "Arn": "arn:aws:iam::111122223333:policy/OpsBoundary",
      "AttachmentCount": 1,
      "DefaultVersionId": "v1",
      "IsAttachable": true,
      "PolicyName": "OpsBoundary",
      "PolicyVersionList": [
        {
          "Document": {
            "Statement": [
              {
                "Action": [
                  "ec2:*",
                  "ssm:*",
                  "sns:*",
                  "logs:*"
                ],
                "Effect": "Allow",
                "Resource": [
                  "*"
