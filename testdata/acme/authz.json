                "Sid": "BoundaryAllow"
              },
              {
                "Action": [
                  "ec2:TerminateInstances"
                ],
                "Effect": "Deny",
                "Resource": [
                  "*"
                ],
                "Sid": "NoTerminate"
              }
            ],
            "Version": "2012-10-17"
          },
          "IsDefaultVersion": true,
          "VersionId": "v1"
        }
      ]
    }
