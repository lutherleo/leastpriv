{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEc2",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:StartInstances",
        "ec2:StopInstances"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:111122223333:instance/i-0a1b2c3d4e5f60001",
        "arn:aws:ec2:us-east-1:111122223333:instance/i-0a1b2c3d4e5f60002",
        "arn:aws:ec2:us-east-1:111122223333:instance/i-0a1b2c3d4e5f60003"
      ]
    },
    {
      "Sid": "AllowEc2N2",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeSnapshots",
        "ec2:DescribeVolumes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowSns",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:111122223333:ops-alerts"
    },
    {
      "Sid": "AllowSsm",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1:111122223333:parameter/ops/schedule/*"
    }
  ]
}
